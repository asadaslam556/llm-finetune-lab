# Copy this to .env and fill in what you need. Everything here is optional:
# a dry run works with no .env at all.
#
# Two naming styles both work. LFL_* is this project's namespace, and the
# vendor's own standard name (ANTHROPIC_API_KEY, OPENAI_API_KEY, HF_TOKEN)
# is read as a fallback, so if you already have those exported for the
# official SDKs you do not need to set anything twice.
#
# .env is gitignored. Never commit a real key.

# ---------------------------------------------------------------- providers
# Which provider the chat panel uses by default.
# ollama | anthropic | deepseek | openai | custom | mock
LFL_DEFAULT_PROVIDER=ollama

# --- Ollama (local, no account, no key) ---
LFL_OLLAMA_HOST=http://localhost:11434

# --- Anthropic / Claude ---
# Leave the base URL unset for api.anthropic.com. Set it to route through a
# gateway (corporate proxy, LiteLLM, or similar); the request shape is the same.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5

# --- DeepSeek (OpenAI-compatible) ---
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Any other OpenAI-compatible endpoint ---
# Together, Groq, OpenRouter, Fireworks, a local vLLM, and so on. Set these
# three and the "custom" provider appears in the picker. No code changes.
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=https://api.together.xyz/v1
# CUSTOM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# LFL_CUSTOM_LABEL=Together

# --- Hugging Face ---
# Only needed for gated models (Llama, Gemma) or private repos. The default
# Qwen model is public and downloads without any of this. `hf auth login`
# works too. See docs/credentials.md.
# HF_TOKEN=hf_...

# ------------------------------------------------------------------- models
# LFL_BASE_MODEL_HF=Qwen/Qwen2.5-0.5B-Instruct
# LFL_OLLAMA_BASE_TAG=qwen2.5:0.5b-instruct
# LFL_DEPLOY_NAME=nimbus-support

# QLoRA really earns its keep at this size. Needs a 12 GB card or better.
# LFL_BASE_MODEL_HF=Qwen/Qwen2.5-7B-Instruct

# ------------------------------------------------------------- QLoRA / LoRA
# qlora loads the frozen base in 4-bit. lora keeps it in bf16.
# Defaults to qlora, and falls back to lora with a logged reason when the
# machine has no CUDA device or no bitsandbytes.
# LFL_FINETUNE_STRATEGY=qlora
# LFL_QUANT_BITS=4
# LFL_QUANT_TYPE=nf4
# LFL_DOUBLE_QUANT=true
# LFL_COMPUTE_DTYPE=auto
# LFL_GRADIENT_CHECKPOINTING=true

# LFL_LORA_R=16
# LFL_LORA_ALPHA=32
# LFL_LORA_DROPOUT=0.05

# ------------------------------------------------------------------ trainer
# LFL_NUM_EPOCHS=1
# LFL_LEARNING_RATE=0.0002
# LFL_BATCH_SIZE=4
# LFL_MAX_SEQ_LEN=512
# LFL_OPTIMIZER=paged_adamw_8bit

# ------------------------------------------------------------------- export
# The export stage needs llama.cpp's converter. Point at the file directly and
# it skips the PATH hunt, which usually fails since the script is not marked
# executable. Remember to pip install -r llama.cpp/requirements.txt too.
# LFL_GGUF_CONVERT_SCRIPT=C:\path\to\llama.cpp\convert_hf_to_gguf.py
# LFL_OLLAMA_BIN=ollama
# LFL_GGUF_OUTTYPE=q8_0

# -------------------------------------------------------------------- server
# Where the built frontend is served from, if not the Vite dev server.
# LFL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host names the API answers to (DNS-rebinding protection). Add a name here
# only if you deliberately reach the API under it.
# LFL_ALLOWED_HOSTS=localhost,127.0.0.1
